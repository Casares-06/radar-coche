{
  "manifest_version": 3,
  "name": "Radar Coche",
  "version": "0.3.0",
  "description": "Guarda y revisa anuncios de coches usados en tu navegador. Sin cuenta ni servidor.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Revisar este anuncio con Radar Coche",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
